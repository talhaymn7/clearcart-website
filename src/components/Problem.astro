---
import { useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cards = t<{ title: string; body: string }[]>('problem.cards');
---

{/*
  Sayfanın tek koyu bloğu (.section-invert). Bej bölümlerin arasında durup
  ritmi kırar; başlık burada sayfanın en iri ikinci tipografisidir.
  Başlık/gövde metni beyaz, zemin --brand-deep: kontrast ~7.4:1.
*/}
<section id="sorun" class="section section-invert">
  <div class="wrap">
    <h2 class="section-title">
      {t('problem.heading')}
    </h2>

    <dl class="mt-9 grid sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((card, index) => (
          <div
            class:list={[
              'border-t border-white/30 py-5',
              // Orta sütunun yan çizgileri yalnızca üç sütuna açıldığında anlamlı.
              index === 0 && 'lg:pr-7',
              index === 1 && 'sm:pl-7 sm:border-l sm:border-l-white/20 lg:px-7',
              index === 2 && 'lg:pl-7 lg:border-l lg:border-l-white/20',
            ]}
          >
            <dt class="text-xl font-bold">{card.title}</dt>
            <dd class="mt-2 text-white/85">{card.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
