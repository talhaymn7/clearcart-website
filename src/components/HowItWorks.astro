---
import { useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const steps = t<{ title: string; body: string }[]>('how.steps');
---

{/*
  Kart ızgarası değil: adımlar yalnızca üstlerindeki çizgi ve iri numarayla
  ayrılır. Bir önceki ve sonraki bölüm kutulu olduğu için sayfanın ritmini
  bu bölüm kırar.
*/}
<section id="nasil-calisir" class="section">
  <div class="wrap">
    <h2 class="section-title">{t('how.heading')}</h2>

    <ol class="mt-8 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="flex flex-col gap-2.5 border-t-2 border-brand/70 pt-6">
            <span class="text-[2.5rem] font-bold leading-none text-brand-deep" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="text-lg font-semibold">{step.title}</h3>
            <p class="text-ink-soft">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="measure mt-7 text-sm text-ink-soft">{t('how.note')}</p>
  </div>
</section>
