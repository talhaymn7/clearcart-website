---
import { useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const steps = t<{ title: string; body: string }[]>('how.steps');
---

<section id="nasil-calisir" class="section bg-surface-card">
  <div class="wrap">
    <h2 class="measure text-3xl font-bold sm:text-4xl">{t('how.heading')}</h2>

    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="relative rounded-card border border-brand/45 bg-surface p-6">
            <div class="flex items-center gap-3">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-brand/30 text-brand-deep">
                {index === 0 && (
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h2.2l1.3-2h7l1.3 2h2.2A1.5 1.5 0 0 1 20 8.5v9A1.5 1.5 0 0 1 18.5 19h-13A1.5 1.5 0 0 1 4 17.5z" />
                    <circle cx="11.8" cy="13" r="3.4" />
                  </svg>
                )}
                {index === 1 && (
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M4 6v12M7 6v12M10.5 6v12M14 6v12M17.5 6v12M20 6v12" />
                  </svg>
                )}
                {index === 2 && (
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M12 3l7 3v5.5c0 4.3-2.9 7.9-7 9.5-4.1-1.6-7-5.2-7-9.5V6z" />
                    <path d="M12 8.5v4" />
                    <path d="M12 15.6h.01" />
                  </svg>
                )}
              </span>
              <span class="text-sm font-bold uppercase tracking-wide text-brand-deep">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <h3 class="mt-4 text-lg font-semibold">{step.title}</h3>
            <p class="mt-2 text-ink-soft">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="measure mt-8 text-sm text-ink-soft">{t('how.note')}</p>
  </div>
</section>
