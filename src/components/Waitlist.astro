---
import { SITE } from '../config.ts';
import { useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/*
  Sayfanın kapanışı: kart içinde değil, tam genişlik bir bant olarak durur.
  Form JS'siz de klasik POST olarak çalışır; aşağıdaki script yalnızca sayfayı
  terk etmeden gönderim yapar.
*/}
<section
  id="bekleme-listesi"
  class="section relative overflow-hidden border-y border-brand/45 bg-surface-card"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(90%_120%_at_50%_100%,var(--color-brand)_0%,transparent_65%)] opacity-45"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative max-w-[40rem] text-center">
    <h2 class="section-title mx-auto">
      {t('waitlist.heading')}
    </h2>
    <p class="mt-4 text-[17px] text-ink-soft">{t('waitlist.description')}</p>

    <form
      id="waitlist-form"
      action={SITE.formEndpoint}
      method="POST"
      class="mt-8 flex flex-wrap justify-center gap-2.5"
      data-success={t('waitlist.success')}
      data-error={t('waitlist.error')}
      data-sending={t('waitlist.sending')}
    >
      <label for="email" class="sr-only">{t('waitlist.label')}</label>

      <!-- Formspree e-postanın "reply-to" adresini bu alandan okur: name="email" şart. -->
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder={t('waitlist.placeholder')}
        class="min-w-0 flex-[1_1_16rem] rounded-full border border-brand-deep/40 bg-white px-5 py-3.5 text-ink placeholder:text-ink-soft"
      />
      <button type="submit" id="waitlist-submit" class="btn btn-primary shrink-0 px-8 py-3.5">
        {t('waitlist.button')}
      </button>

      <!-- Formspree'nin kendi bot tuzağı -->
      <input
        type="text"
        name="_gotcha"
        tabindex="-1"
        aria-hidden="true"
        autocomplete="off"
        class="absolute left-[-9999px] h-0 w-0 opacity-0"
      />
      <input type="hidden" name="_subject" value={t('waitlist.subject')} />
    </form>

    <p
      id="waitlist-status"
      role="status"
      aria-live="polite"
      class="mt-4 min-h-[1.4em] font-semibold text-brand-deep"
    >
    </p>
    <p class="mt-1 text-[13px] text-ink-soft">{t('waitlist.privacy')}</p>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const status = document.getElementById('waitlist-status');
  const submit = document.getElementById('waitlist-submit') as HTMLButtonElement | null;

  if (form && status && submit) {
    const idleLabel = submit.textContent ?? '';

    const show = (message: string, ok: boolean) => {
      status.textContent = message;
      status.classList.toggle('text-brand-deep', ok);
      status.classList.toggle('text-warn', !ok);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      submit.disabled = true;
      submit.textContent = form.dataset.sending ?? idleLabel;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });

        if (response.ok) {
          form.hidden = true;
          show(form.dataset.success ?? '', true);
          return;
        }

        // Formspree alan bazlı hata mesajları İngilizce gelir; kendi metnimizi gösteriyoruz.
        show(form.dataset.error ?? '', false);
      } catch {
        show(form.dataset.error ?? '', false);
      }

      submit.disabled = false;
      submit.textContent = idleLabel;
    });
  }
</script>
