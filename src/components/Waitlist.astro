---
import { SITE } from '../config.ts';
import { useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="bekleme-listesi" class="section">
  <div class="wrap">
    <div
      class="rounded-card border border-brand/50 bg-gradient-to-br from-brand/25 via-surface-card to-surface-card p-7 sm:p-10"
    >
      <h2 class="measure text-3xl font-bold sm:text-4xl">{t('waitlist.heading')}</h2>
      <p class="measure mt-3 text-ink-soft">{t('waitlist.description')}</p>

      <form
        id="waitlist-form"
        action={SITE.formEndpoint}
        method="POST"
        class="mt-7 max-w-xl"
        data-success={t('waitlist.success')}
        data-error={t('waitlist.error')}
        data-sending={t('waitlist.sending')}
      >
        <!-- Formspree e-postanın "reply-to" adresini bu alandan okur: name="email" şart. -->
        <label for="email" class="block text-sm font-semibold text-brand-deep">
          {t('waitlist.label')}
        </label>

        <div class="mt-2 flex flex-col gap-3 sm:flex-row">
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder={t('waitlist.placeholder')}
            class="w-full rounded-full border border-brand-deep/40 bg-white px-4 py-3 text-ink placeholder:text-ink-soft"
          />
          <button type="submit" id="waitlist-submit" class="btn btn-primary shrink-0">
            {t('waitlist.button')}
          </button>
        </div>

        <!-- Formspree'nin kendi bot tuzağı -->
        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          aria-hidden="true"
          autocomplete="off"
          class="absolute left-[-9999px] h-0 w-0 opacity-0"
        />
        <input type="hidden" name="_subject" value={t('waitlist.subject')} />

        <p class="mt-3 text-sm text-ink-soft">{t('waitlist.privacy')}</p>
      </form>

      <p
        id="waitlist-status"
        role="status"
        aria-live="polite"
        class="mt-4 hidden max-w-xl rounded-soft border px-4 py-3 font-medium"
      >
      </p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const status = document.getElementById('waitlist-status');
  const submit = document.getElementById('waitlist-submit') as HTMLButtonElement | null;

  if (form && status && submit) {
    const idleLabel = submit.textContent ?? '';

    const show = (message: string, ok: boolean) => {
      status.textContent = message;
      status.classList.remove('hidden');
      status.classList.toggle('border-brand-deep', ok);
      status.classList.toggle('bg-brand/20', ok);
      status.classList.toggle('text-brand-deep', ok);
      status.classList.toggle('border-red-700', !ok);
      status.classList.toggle('bg-red-50', !ok);
      status.classList.toggle('text-red-800', !ok);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      submit.disabled = true;
      submit.textContent = form.dataset.sending ?? idleLabel;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });

        if (response.ok) {
          form.hidden = true;
          show(form.dataset.success ?? '', true);
          return;
        }

        // Formspree alan bazlı hata mesajları İngilizce gelir; kendi metnimizi gösteriyoruz.
        show(form.dataset.error ?? '', false);
      } catch {
        show(form.dataset.error ?? '', false);
      }

      submit.disabled = false;
      submit.textContent = idleLabel;
    });
  }
</script>
