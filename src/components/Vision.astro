---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/ui.ts';
import mockup from '../img/mockup.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const values = t<{ title: string; body: string }[]>('vision.values');
---

<section class="section">
  <div class="wrap">
    <h1 class="measure text-4xl font-bold sm:text-5xl">{t('vision.heading')}</h1>

    <div class="mt-12 grid items-center gap-10 md:grid-cols-[1.15fr_0.85fr] md:gap-14">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">{t('vision.visionHeading')}</h2>
        <p class="measure mt-4 text-lg text-ink-soft">{t('vision.visionBody')}</p>

        <h2 class="mt-12 text-2xl font-bold sm:text-3xl">{t('vision.missionHeading')}</h2>
        <p class="measure mt-4 text-lg text-ink-soft">{t('vision.missionBody')}</p>
      </div>

      {/* Mockup kendi mor zeminiyle geliyor; .screen-frame'e konmaz, doğrudan
          yerleştirilir. Hero.astro'daki kullanımın aynısı. */}
      <div class="mx-auto w-full max-w-[18rem] sm:max-w-[21rem]">
        <Image
          src={mockup}
          alt={t('hero.imageAlt')}
          widths={[288, 336, 380]}
          sizes="(min-width: 768px) 21rem, 18rem"
          loading="eager"
          class="w-full rounded-[1.75rem] shadow-xl shadow-brand-deep/20"
        />
      </div>
    </div>

    <h2 class="mt-14 text-2xl font-bold sm:text-3xl">{t('vision.valuesHeading')}</h2>

    <ul class="mt-8 grid gap-5 sm:grid-cols-3">
      {
        values.map((value) => (
          <li class="card">
            <h3 class="text-lg font-semibold">{value.title}</h3>
            <p class="mt-2 text-ink-soft">{value.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
