---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/ui.ts';
import home from '../img/screens/home.png';
import allergens from '../img/screens/allergens.png';
import scanResult from '../img/screens/scan-result.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = t<{ caption: string; alt: string }[]>('screens.items');
const sources = [home, allergens, scanResult];

// Görsel sayısı ile metin sayısı ayrı yerlerde durduğu için eşleşmeyi doğrularız.
if (sources.length !== items.length) {
  throw new Error(
    `[screens] görsel sayısı (${sources.length}) metin sayısıyla (${items.length}) eşleşmiyor.`
  );
}
---

<section id="ekranlar" class="section border-t border-brand/40">
  <div class="wrap">
    <h2 class="section-title mx-auto text-center">{t('screens.heading')}</h2>

    <ul class="mx-auto mt-10 grid max-w-[52rem] gap-6 sm:grid-cols-3 sm:gap-7">
      {
        items.map((item, index) => (
          <li>
            <figure class="m-0">
              <div class="phone-frame">
                <div class="phone-screen">
                  <Image
                    src={sources[index]}
                    alt={item.alt}
                    widths={[240, 480]}
                    sizes="(min-width: 640px) 15rem, 100vw"
                    loading="lazy"
                  />
                </div>
              </div>
              <figcaption class="mt-3.5 text-center text-[15px] font-semibold text-brand-deep">
                {item.caption}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
