---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/ui.ts';
import home from '../img/screens/home.png';
import allergens from '../img/screens/allergens.png';
import scanResult from '../img/screens/scan-result.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = t<{ caption: string; alt: string }[]>('screens.items');
const sources = [home, allergens, scanResult];
---

<section id="ekranlar" class="section bg-surface-card">
  <div class="wrap">
    <h2 class="measure text-3xl font-bold sm:text-4xl">{t('screens.heading')}</h2>
    <p class="measure mt-3 text-ink-soft">{t('screens.description')}</p>

    <ul class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        items.map((item, index) => (
          <li>
            <div class="screen-frame mx-auto max-w-[15rem] sm:max-w-[17rem]">
              <Image
                src={sources[index]}
                alt={item.alt}
                widths={[240, 272, 480, 544]}
                sizes="(min-width: 640px) 17rem, 15rem"
                loading="lazy"
              />
            </div>
            <p class="mt-3 text-center text-sm text-ink-soft">
              {String(index + 1)}. {item.caption}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
