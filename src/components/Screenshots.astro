---
import { useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = t<string[]>('screens.items');
const placeholder = t('screens.placeholder');
---

<section id="ekranlar" class="section bg-surface-card">
  <div class="wrap">
    <h2 class="measure text-3xl font-bold sm:text-4xl">{t('screens.heading')}</h2>
    <p class="measure mt-3 text-ink-soft">{t('screens.description')}</p>

    <!-- SCREENSHOT: bu kutuları public/screens/01.png, 02.png, 03.png ile değiştir
         (9:16 oranında, örn. 1080×1920). Nasıl ekleneceği README'de anlatılıyor. -->
    <ul class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        items.map((caption, index) => (
          <li>
            <div class="screen-frame">
              <span class="px-4 text-center text-sm font-medium text-ink-soft">{placeholder}</span>
            </div>
            <p class="mt-3 text-center text-sm text-ink-soft">
              {String(index + 1)}. {caption}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
