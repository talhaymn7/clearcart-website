---
import { withBase } from '../i18n/ui.ts';

interface Props {
  class?: string;
}

const { class: className = 'h-8 w-8' } = Astro.props;
---

<!--
  Marka işareti: src/img/clear_cart_logo.png içindeki orijinal logodan üretilmiştir
  (sepet + üç kesişen yuvarlak; "CLEAR CART" yazısı ve dış zemin çıkarıldı).
  Yeniden üretmek için README'deki "Logo ve favicon" bölümüne bakın.
  Marka adı hemen yanında yazdığı için görsel dekoratiftir: alt="".
-->
<img
  src={withBase('logo.png')}
  alt=""
  width="512"
  height="512"
  decoding="async"
  class={`${className} rounded-[22%]`}
/>
