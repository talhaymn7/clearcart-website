---
import fs from 'node:fs';
import path from 'node:path';
import '../styles/global.css';
import { SITE, hasSiteUrl, siteOrigin } from '../config.ts';
import { useTranslations, langPath, withBase, type Lang } from '../i18n/ui.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  /**
   * Bu sayfanın her dildeki yolu. Verilmezse dil ana sayfaları varsayılır.
   * Alt sayfalar kendi yollarını geçirmek zorundadır, aksi halde canonical
   * ve hreflang yanlış adresi (dilin kökünü) gösterir.
   */
  paths?: Record<Lang, string>;
  /** Sayfaya özel başlık/açıklama. Verilmezse ana sayfanınki kullanılır. */
  title?: string;
  description?: string;
}

const { lang, paths, title, description } = Astro.props;
const t = useTranslations(lang);

const pagePaths = paths ?? { tr: langPath('tr'), en: langPath('en') };
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');

// Sosyal medya görseli yalnızca PNG gerçekten üretildiyse duyurulur (botlar SVG işlemez).
const ogImageExists = fs.existsSync(path.join(process.cwd(), 'public', 'og-image.png'));
const ogImage = hasSiteUrl && ogImageExists ? `${siteOrigin}${withBase('og-image.png')}` : null;

// siteUrl boşken canonical / hreflang üretilmez.
// pagePaths değerleri withBase'den geçmiş olarak gelir, burada sadece origin eklenir.
const canonical = hasSiteUrl ? `${siteOrigin}${pagePaths[lang]}` : null;
const alternates = hasSiteUrl
  ? [
      { hreflang: 'tr', href: `${siteOrigin}${pagePaths.tr}` },
      { hreflang: 'en', href: `${siteOrigin}${pagePaths.en}` },
      { hreflang: 'x-default', href: `${siteOrigin}${pagePaths.tr}` },
    ]
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#674879" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('apple-touch-icon.png')} />

    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={t('meta.ogImageAlt')} />
        </>
      )
    }

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>

  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-brand-deep focus:px-4 focus:py-2 focus:text-white">
      {t('nav.skipToContent')}
    </a>

    <Header lang={lang} paths={pagePaths} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
